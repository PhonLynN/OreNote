<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      三个提醒相关权限，缺一不可：
        POST_NOTIFICATIONS     Android 13+ 发通知需要运行时授权
        SCHEDULE_EXACT_ALARM   Android 12+ 精确闹钟需要用户手动授予
        RECEIVE_BOOT_COMPLETED 重启后要能把闹钟重建回来
      拿不到前两个时应用会降级（非精确闹钟 + 不崩），而不是直接失效。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      云同步（Cloudflare R2）需要联网。
      注意：**不加 ACCESS_NETWORK_STATE** —— 当前实现不做联网前的状态预检，
      而是直接发起请求、按结果失败（更少的权限、也没有"以为没网其实有网"的误判）。
      将来做「仅 Wi-Fi」开关时需要它，届时再加并在此说明原因。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OrePlanApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrePlan">

        <!--
          android:windowSoftInputMode="adjustNothing"  （不是 adjustResize）

          三个取值为什么只有这个对（三次踩坑换来的）。

          这个 App 是 edge-to-edge + Compose 自己消费 insets 的结构，
          而软键盘有三条互斥的处理路径，选错任意一条都会出问题：

          · 不写（默认）：系统**平移**窗口去露出输入框。
            位移与 Compose 的 inset **叠加** —— 输入框被抬到远高于键盘，
            顶栏被推出屏幕上方，开始打字后才回位。

          · adjustResize：系统**缩小**窗口。
            窗口先短一截，Compose 的 safeDrawing 再按 IME inset 缩一次，
            **同一段键盘高度被减了两遍**。表现为输入框下方留出一条
            「与背景同色的矩形空带」，列表也被提前截断。
            这一档最容易误选：它听着最"正确"，在 edge-to-edge 下**本该**
            是空操作，但真机上窗口确实被缩了。用户实测反馈就是
            「输入框外侧有一个和背景同色的边框，文字在输入框上方提前截断」。

          · adjustNothing：系统既不平移也不缩放，键盘高度**只由 Compose
            的 inset 消费一次**。← 正确取值

          需要 API 30+（本 App minSdk 36，满足）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OrePlan"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          附件的外部打开：pdf / word / excel 交给系统查看器时，需要把内部存储里的文件
          临时授权给那个应用。没有这一段，`FileProvider.getUriForFile` 会直接抛异常。
          path 只开放 `files/attachments/`，不开放整个 files 目录。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 闹钟到点：发通知并补排下一次 -->
        <receiver
            android:name=".platform.reminder.ReminderReceiver"
            android:exported="false" />

        <!--
            云同步的定时触发。exported="false"：只有本应用能唤起它 ——
            否则任何应用都能触发我们发网络请求（浪费流量与配额）。

            没有 intent-filter：这个闹钟是**显式 Intent**（直接指定类名）排定的，
            系统能投递到它，而外部应用无法伪造。
        -->
        <receiver
            android:name=".platform.sync.SyncAlarmReceiver"
            android:exported="false" />

        <!-- 开机 / 应用被更新后重建全部闹钟 -->
        <receiver
            android:name=".platform.reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 今日小组件。必须 exported=true：快照更新广播由系统桌面发出 -->
        <receiver
            android:name=".platform.widget.TodayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

    </application>

</manifest>
